{
  "name": "@parley/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Parley on your own computer",
  "author": "Parley",
  "homepage": "https://github.com/lepreem/parley",
  "desktopName": "parley.desktop",
  "main": "dist/main.js",
  "packageManager": "npm@11.14.1",
  "scripts": {
    "build": "tsx scripts/build.mts",
    "stage": "tsx scripts/stage.mts",
    "start": "npm run build && electron .",
    "package": "npm run build && npm run stage && electron-builder --publish never",
    "smoke": "tsx scripts/smoke.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "qrcode-generator": "2.0.4",
    "tsx": "4.20.5",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
