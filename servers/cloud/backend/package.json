{
  "name": "@parley/cloud",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.14.1",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "start:api": "node dist/api.js",
    "dev": "npm run --silent doppler -- tsx watch --inspect=9229 src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db": "npm run --silent doppler -- drizzle-kit push",
    "db:generate": "npm run --silent doppler -- drizzle-kit generate",
    "db:migrate": "npm run --silent doppler -- drizzle-kit migrate",
    "db:baseline": "npm run --silent doppler -- tsx scripts/baseline.ts",
    "storage:push": "npm run --silent doppler -- tsx scripts/pushStorage.ts",
    "test": "npm run --silent doppler -- vitest run",
    "test:watch": "npm run --silent doppler -- vitest",
    "doppler": "set -a; [ -f ../.env ] && . ../.env; set +a; exec mise exec -- doppler run --"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.7.0",
    "@hono/node-server": "1.19.17",
    "@openrouter/sdk": "^1.2.38",
    "@parley/contract": "*",
    "@parley/server-kit": "*",
    "@supabase/supabase-js": "2.103.0",
    "@workos-inc/node": "9.1.0",
    "amqplib": "1.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.13",
    "hono-rate-limiter": "0.5.3",
    "jose": "6.2.12",
    "postgres": "^3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/node": "25.6.0",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "tsx": "4.20.5",
    "typescript": "5.7.3",
    "typescript-eslint": "8.57.0",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
