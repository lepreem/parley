# Supabase Postgres connection string (Project Settings → Database → Connection string).
# Prefer a pooler URI — host aws-<n>-<region>.pooler.supabase.com, user
# postgres.<project-ref> — since it resolves over IPv4 and works everywhere:
#   - Session pooler (port 5432): use this, for the app and migrations alike.
#   - Transaction pooler (port 6543): not supported. It breaks the prepared
#     statements every query uses, so src/db/index.ts refuses to start with it.
# The direct connection (db.<project-ref>.supabase.co:5432) is IPv6-only and
# will hang in IPv4-only environments (e.g. this devcontainer).
DATABASE_URL=
MQ_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Dictating a message: an OpenRouter key of its own, whose credit limit is the
# cap on what dictation can spend. Without it, the server refuses to dictate.
OPENROUTER_DICTATION_API_KEY=
# Speech-to-text for files. Separate from OpenRouter: it runs on Deepgram,
# which takes a signed bucket URL and returns a full transcript for audio of
# any length. Key from console.deepgram.com → API Keys.
DEEPGRAM_API_KEY=
NODE_ENV=development

# Doppler (config dev) is the source of truth for all of these — this file is
# only a fallback, and the app logs a red warning when it is used.
# Use localhost everywhere in dev — not 127.0.0.1 — so the session cookie is sent.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Where the browser reaches the client, and where WorkOS/the fetcher reach this
# API. Both are required — there is no localhost default. In production the API
# serves the client, so both are its own public URL.
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
PORT=3001

