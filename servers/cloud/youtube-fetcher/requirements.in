# What the fetcher installs. requirements.txt is compiled from this, with every
# package, direct or not, pinned to a version and the hashes of its files, so
# pip installs nothing it hasn't seen before. Recompile after editing this, or
# to move a package on, with the command at the top of requirements.txt (add
# --upgrade-package <name> for each package to update).
httpx
pika
supabase
yt-dlp
# yt-dlp plugins: yt-dlp-ejs solves YouTube's JavaScript challenges, and
# bgutil-ytdlp-pot-provider fetches proof-of-origin tokens.
yt-dlp-ejs
bgutil-ytdlp-pot-provider
