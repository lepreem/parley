# Copy to .env to change any of these; every one is optional, and the
# defaults are shown.

# Where the app keeps its files: the database, uploads and Whisper models.
# Give a full path; ~ isn't expanded here.
# DATA_DIR=/Users/you/.parley

# The port the app listens on, on 127.0.0.1 only.
# PORT=3002

# Names the app answers to besides this machine's, comma-separated: the
# Tailscale name `tailscale serve` puts it behind, to use it from your phone.
# See "Use it from your phone" in the README.
# ALLOWED_HOSTS=macbook.tail1234.ts.net

# The programs the app runs, when they aren't on PATH. Claude Code must be
# logged in (run `claude` once and sign in).
# CLAUDE_PATH=claude
# YT_DLP_PATH=yt-dlp

# Where the built client is, relative to servers/local/.
# CLIENT_DIR=../../client/dist
